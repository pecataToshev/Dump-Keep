# Copy to .env for local runs (never commit .env).
# The binary reads plain env vars; load the file with:
#   set -a; . ./.env; set +a; go run .

# ─── Required (all deployments) ───────────────────────────────────────────

# Superuser connection string to the PostgreSQL instance.
POSTGRES_URL=postgresql://postgres:password@host:5432/postgres

# age public key (age1...). Private key stays offline.
# Generate the pair with: age-keygen -o dump-keep-key.txt
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storage backend: "gdrive" or "s3"
STORAGE_BACKEND=gdrive

# ─── Google Drive backend (required when STORAGE_BACKEND=gdrive) ──────────

# Google service account key — the full JSON on one line.
GDRIVE_SA_JSON={"type":"service_account","project_id":"..."}

# Shared Drive ID, from https://drive.google.com/drive/folders/<ID>
GDRIVE_SHARED_DRIVE_ID=0AXxxxxxxxxxxUk9PVA

# Optional: parent folder ID for the backups (from the folder URL).
# Unset: backups land in the Shared Drive root.
# GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# ─── S3 backend (required when STORAGE_BACKEND=s3) ────────────────────────

# Endpoint URL (e.g. https://s3.amazonaws.com, https://s3.eu-west-1.amazonaws.com,
# or your MinIO/R2/B2 endpoint). Use http:// for local MinIO.
S3_ENDPOINT=https://s3.amazonaws.com

# Bucket name (must already exist — dump-keep does not create buckets).
S3_BUCKET=my-backup-bucket

# Region (e.g. us-east-1). Some S3-compatible storages ignore this.
S3_REGION=us-east-1

# Access key and secret.
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Use path-style addressing (https://endpoint/bucket/key).
# Required for MinIO and some S3-compatible storages. Set to false for AWS S3.
S3_PATH_STYLE=false

# Optional: key prefix for all backups (e.g. "backups/postgres/").
# Unset: backups land at the bucket root.
# S3_PREFIX=backups/postgres/

# ─── Skip list (optional) ─────────────────────────────────────────────────

# Comma-separated list of databases to skip (e.g. "postgres,test_db,staging").
# SKIP_DATABASES=postgres,test_db

# Path to a file listing databases to skip (one per line, # = comment).
# See skip.example.txt for the format. Both sources are merged if set.
# SKIP_DATABASES_FILE_PATH=/etc/dump-keep/skip.txt

# ─── Retention (optional) ─────────────────────────────────────────────────

# Retention durations as positional "daily,weekly,monthly" with unit suffixes
# (h=hours, d=days, w=weeks, m=months of 31 days).
# Examples:
#   RETENTION=7d,4w,24m   (default: daily 7d, weekly 4w, monthly 24m)
#   RETENTION=14d,8w,12m  (keep daily 14 days, weekly 8 weeks, monthly 12 months)
#   RETENTION=none         (disable pruning entirely — keep all backups forever)
# RETENTION=7d,4w,24m

# ─── Notifications (optional, all can be set simultaneously) ──────────────

# healthchecks.io ping URL (pinged on success, /fail on failure)
# HEALTHCHECK_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Discord channel webhook (failures + success heartbeats on configured tiers)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# Slack incoming webhook (failures + success heartbeats on configured tiers)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Which backup tiers trigger a success notification (comma-separated).
# Options: daily, weekly, monthly, none (disable success notifications).
# Default: weekly,monthly
# NOTIFY_TIERS=weekly,monthly
